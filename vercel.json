{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)",          "dest": "/api/index.js"          },
    { "src": "/css/(.*)",          "dest": "/frontend/css/$1"        },
    { "src": "/js/(.*)",           "dest": "/frontend/js/$1"         },
    { "src": "/donors.html",       "dest": "/frontend/donors.html"   },
    { "src": "/recipients.html",   "dest": "/frontend/recipients.html"},
    { "src": "/donations.html",    "dest": "/frontend/donations.html" },
    { "src": "/inventory.html",    "dest": "/frontend/inventory.html" },
    { "src": "/requests.html",     "dest": "/frontend/requests.html"  },
    { "src": "/emergency.html",    "dest": "/frontend/emergency.html" },
    { "src": "/appointments.html", "dest": "/frontend/appointments.html"},
    { "src": "/(.*)",              "dest": "/frontend/index.html"    }
  ]
}
